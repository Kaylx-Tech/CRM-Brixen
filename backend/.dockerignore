.git/
.gitignore
.vscode/
.idea/
.cursor/
.DS_Store

# ── Virtualenv ─────────────────────────────────────────────
.venv/
venv/

# ── Local DBs / backups (mount volume in Coolify instead) ─
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.db.bak
backup-DB/
hypetex.db.bak
ledger.db

# ── Environment / secrets (set in Coolify UI) ──────────────
.env
.env.local
.env.production

# ── Docs / noise noise ───────────────────────────────────
*.md
*.html
*.pdf
PORTAL_DOCUMENTATION*

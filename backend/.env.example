# ============================================================
# Brixen CRM API — Environment Template (Coolify / Docker)
# ============================================================
# Coolify: New Resource → Dockerfile → Base Directory = backend
# Paste these as Environment Variables (do NOT commit real secrets).
# ============================================================

# ── 1. Server ────────────────────────────────────────────────
HOST=0.0.0.0
# Coolify often injects PORT automatically — keep 5050 if unset
PORT=5050
CRM_ENV=production

# ── 2. Security (REQUIRED in production) ─────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
COOKIE_SECURE=true
# MUST be 0 / unset on live servers
DEV_AUTH_BYPASS=0

# ── 3. Public URLs (emails + CORS) ───────────────────────────
FRONTEND_URL=https://admin.brixenconsultants.com
PORTAL_URL=https://portal.brixenconsultants.com
# Public API URL (optional — for docs / webhooks)
API_PUBLIC_URL=https://api.brixenconsultants.com
# Extra allowed browser origins (comma-separated), if frontend domain differs
EXTRA_CORS_ORIGINS=

# ── 4. Database & Storage (inside container) ─────────────────
# Live VPS path — Coolify MUST mount this host file into the container:
#   Host file:      /var/www/brixen-crm/hypetex.db
#   Container path: /var/www/brixen-crm/hypetex.db  (same path)
# Optional storage:
#   Host dir:       /var/www/brixen-crm/storage
#   Container path: /var/www/brixen-crm/storage
DATABASE_URL=/var/www/brixen-crm/hypetex.db
STORAGE_PATH=/var/www/brixen-crm/storage

# ── 5. SMTP ──────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=notifications@brixenconsultants.com
SMTP_PASS=
SMTP_FROM=notifications@brixenconsultants.com

# ── 6. Google Drive (optional) ───────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_ROOT_FOLDER=Brixen-CRM
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── 7. Companies House / WordPress ───────────────────────────
COMPANIES_HOUSE_API_KEY=
WORDPRESS_WEBHOOK_SECRET=
WORDPRESS_URL=https://brixenconsultants.com

# ============================================================
# Brixen CRM - Environment Configuration Template
# ============================================================

# ── 1. Server & Network ──────────────────────────────────────
HOST=0.0.0.0
PORT=5050
CRM_ENV=development

# ── 2. Security & Sessions ───────────────────────────────────
SECRET_KEY=change_this_to_a_secure_random_string_32_chars_long
COOKIE_SECURE=false

# ── 3. Frontend & CORS ───────────────────────────────────────
FRONTEND_URL=https://admin.brixenconsultants.com
PORTAL_URL=https://portal.brixenconsultants.com

# ── 4. Database & Storage ────────────────────────────────────
DATABASE_URL=hypetex.db
STORAGE_PATH=storage

# ── 5. SMTP Transactional Email ──────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=notifications@brixenconsultants.com
SMTP_PASS=your_email_password_here
SMTP_FROM=notifications@brixenconsultants.com

# ── 6. Google Drive 5TB Storage Integration ──────────────────
# Paste your entire Google Service Account JSON as a single line or string
# Or put Base64: GOOGLE_SERVICE_ACCOUNT_BASE64=...
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER=Brixen-CRM

# ── 7. UK Companies House API (Live Company Sync) ────────────
COMPANIES_HOUSE_API_KEY=

# ── 8. WordPress & WooCommerce Webhook Sync ──────────────────
WORDPRESS_WEBHOOK_SECRET=your_woocommerce_webhook_secret_here

# Production build (Coolify) — Finstap branch
# This branch always builds the Finstap app. The API address must come from Coolify as a Build Variable:
#   VITE_API_URL=https://<finstap-api-domain>/api
# There is deliberately no fallback here, so a Finstap build can never talk to the Brixen live API.
VITE_PRODUCT=finstap
# Each company gets <workspace>.finstap.com (app.finstap.com is the shared signup / find-your-workspace page)
VITE_TENANT_DOMAIN=finstap.com

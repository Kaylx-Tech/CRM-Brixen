# Copy to /etc/server-watchdog.env (chmod 600). install.sh does this for you.
HOST_LABEL=vps-191
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Site watcher heartbeat (same HEARTBEAT_KEY as the Worker secret)
HEARTBEAT_URL=https://site-watcher.<your-subdomain>.workers.dev/heartbeat
HEARTBEAT_KEY=

DISK_LIMIT=85
MEM_MIN_MB=200
MAX_RESTARTS=3

# Checked read-only once an hour (needs: apt install sqlite3)
DB_FILES="/var/www/brixen-new/data/hypetex.db /var/www/finstap/data/*.db /var/www/finstap/data/tenants/*.db"

# Folder where backups land; leave empty to skip
BACKUP_DIR=
BACKUP_MAX_HOURS=26
